<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.seu.vcampus.fx.MainController" styleClass="app-shell">
    <left>
        <VBox prefWidth="238.0" styleClass="sidebar" spacing="24.0">
            <padding><Insets top="30.0" right="18.0" bottom="24.0" left="18.0"/></padding>
            <HBox spacing="11.0" alignment="CENTER_LEFT">
                <Label text="SEU" styleClass="side-mark"/>
                <Label text="VCampus" styleClass="side-title"/>
            </HBox>
            <VBox spacing="5.0">
                <Label text="我的校园" styleClass="nav-caption"/>
                <Button fx:id="academicButton" text="学籍概览" onAction="#showAcademic"
                        styleClass="nav-button, nav-active" maxWidth="1.7976931348623157E308"/>
                <Button fx:id="storeButton" text="校园商店" onAction="#showStore"
                        styleClass="nav-button" maxWidth="1.7976931348623157E308"/>
            </VBox>
            <Separator/>
            <VBox spacing="5.0">
                <Label text="校园服务" styleClass="nav-caption"/>
                <Button text="课程与课表" styleClass="nav-button" maxWidth="1.7976931348623157E308"/>
                <Button text="图书馆" styleClass="nav-button" maxWidth="1.7976931348623157E308"/>
                <Button text="宿舍生活" styleClass="nav-button" maxWidth="1.7976931348623157E308"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="12.0" styleClass="sidebar-account">
                <Label text="当前账号" styleClass="nav-caption"/>
                <Label text="林知远" styleClass="account-name"/>
                <Label text="2023012345 · 学生" styleClass="account-id"/>
                <Button text="退出登录" onAction="#logout" styleClass="logout-button"
                        maxWidth="1.7976931348623157E308"/>
            </VBox>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding><Insets top="22.0" right="34.0" bottom="18.0" left="34.0"/></padding>
            <VBox spacing="3.0">
                <Label text="东南大学校园服务" styleClass="topbar-title"/>
                <Label text="你好，林知远" styleClass="topbar-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="学号 2023012345" styleClass="topbar-id"/>
            <StackPane styleClass="avatar"><Label text="林"/></StackPane>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentHost" styleClass="content-host"/>
    </center>
</BorderPane>
